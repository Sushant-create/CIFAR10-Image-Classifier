# Normalize line endings for all text files
* text=auto eol=lf

# Jupyter notebooks - diff nicely, treat as text
*.ipynb text eol=lf

# Treat these as binary (no line-ending conversion / text diffing)
*.h5 binary
*.keras binary
*.png binary
*.jpg binary
*.jpeg binary

# Track large model files with Git LFS if the repo grows heavy
*.h5 filter=lfs diff=lfs merge=lfs -text
